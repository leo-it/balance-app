<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181b"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balance App"
        android:textColor="#a1a1aa"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_spendable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="—"
        android:textColor="#34d399"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restante gastable"
        android:textColor="#71717a"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_spent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="—"
        android:textColor="#f87171"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_savings_usd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textColor="#38bdf8"
        android:textSize="12sp" />
</LinearLayout>
